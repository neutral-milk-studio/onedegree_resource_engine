# Copy to .env.local. "mock" uses the built-in demo data. "live" calls the API.
VITE_API_MODE=mock
VITE_API_BASE=http://localhost:8000

# Per-specialist Cognito sign-in (optional, live mode only): set these to the AWS deploy's
# pool (terraform output cognito_client_id / your region) to sign in with a real Cognito
# account instead of the shared token. Leave VITE_COGNITO_CLIENT_ID unset to sign in with
# the shared token instead (password = RE_BEARER_TOKEN / JWT_SECRET).
VITE_COGNITO_CLIENT_ID=
VITE_AWS_REGION=us-west-2
