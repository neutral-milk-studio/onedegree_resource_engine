# Copy to .env for local development. Never commit real credentials.
# local | aws. Outside local, JWT_SECRET is required and demo accounts are hidden.
APP_ENV=local
AUTH_MODE=local
JWT_SECRET=change-me
# mock uses the offline stand-in for the model; bedrock uses BEDROCK_MODEL_ID.
LLM_BACKEND=mock
BLOB_BACKEND=local
SEARCH_BACKEND=memory
RE_DATABASE_URL=postgresql://resource_engine:local_dev_only@localhost:5432/resource_engine
RE_OPENSEARCH_URL=http://localhost:9200
RE_S3_ENDPOINT=http://localhost:4566
RE_RAW_BUCKET=resource-engine-raw-local
RE_WEBSITE_SOURCE=sample
RE_SEED_CONTENT_DIR=seed/website_content
AWS_REGION=us-west-2
# Anthropic model (or inference profile) for fact extraction. No default on purpose: check
# which models are enabled in the account. Recommended: Claude Haiku 5.5. Only needed when
# the worker calls Bedrock; tests and the sample demo don't.
BEDROCK_MODEL_ID=
# Sampling temperature for fact extraction: a number, or "omit" if the model rejects it.
RE_MODEL_TEMPERATURE=0

# AI maintenance worker. Blank uses the default shown.
# sweep = the monthly check of records due; reports = checks triggered by user reports.
RE_WORKER_MODE=sweep
# A record is due for a check when its last check is this many days old.
RE_CHECK_INTERVAL_DAYS=30
# Distinct reporters of "unavailable" or "deletion" that trigger a check outside the schedule.
RE_REPORT_SEVERE_THRESHOLD=3
# Distinct reporters of "inaccurate information" that trigger a check outside the schedule.
RE_REPORT_INACCURACY_THRESHOLD=5
# Only reports from the last this-many days count, and only those since the last check.
RE_REPORT_WINDOW_DAYS=30
# No report-triggered check within this many days of the last check. Shorter than the window.
RE_REPORT_COOLDOWN_DAYS=7
ODRS_API_URL=
ODRS_API_KEY=
VITE_API_BASE=http://localhost:8000
