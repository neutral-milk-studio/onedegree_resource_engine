# Copy to .env for local development. Never commit real credentials.
RE_BEARER_TOKEN=local_dev_token
RE_DATABASE_URL=postgresql://resource_engine:local_dev_only@localhost:5432/resource_engine
# Local raw store folder (payloads saved exactly as received). Defaults to var/raw.
RE_RAW_DIR=var/raw
# Ingest source config (mapper module + input files per source).
RE_SOURCES_CONFIG=config/sources.yaml
# Time zone for source opening hours that carry no UTC offset.
RE_DEFAULT_TIMEZONE=America/Los_Angeles
RE_CORS_ORIGINS=http://localhost:5173
RE_LOG_LEVEL=INFO
RE_OPENSEARCH_URL=http://localhost:9200
RE_S3_ENDPOINT=http://localhost:4566
RE_RAW_BUCKET=resource-engine-raw-local
RE_WEBSITE_SOURCE=sample
RE_SEED_CONTENT_DIR=seed/website_content
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=
ODRS_API_URL=
ODRS_API_KEY=
VITE_API_BASE=http://localhost:8000
